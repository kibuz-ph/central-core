model Vehicle {
  id          String      @id @default(uuid())
  type        VehicleType
  brand       String
  plate       String
  color       String
  reference   String
  apartmentId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  apartment Apartment @relation(fields: [apartmentId], references: [id])

  @@map("vehicles")
}

enum VehicleType {
  CAR
  MOTORCICLE
  BYCICLE
}
