model Tower {
  id                   String  @id @default(uuid())
  name                 String
  description          String?
  residentialComplexId String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id])

  @@map("towers")
}